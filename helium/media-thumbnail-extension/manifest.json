{
  "manifest_version": 3,
  "name": "Quickshell Media Artwork",
  "version": "1.0.9",
  "description": "Sends higher-resolution artwork from the active media page to the local Quickshell media bridge.",
  "permissions": ["scripting", "tabs"],
  "host_permissions": ["<all_urls>", "http://127.0.0.1:47831/*"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["media-artwork.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["extension-bridge.js"],
      "run_at": "document_start"
    }
  ]
}
