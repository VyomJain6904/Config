#!/usr/bin/env python3
"""
Quickshell Google Calendar helper — OAuth2 authentication, event fetching, offline caching.
"""
import sys
import os
import json
import urllib.request
import urllib.parse
import subprocess
from datetime import datetime, timedelta
import http.server
import socketserver
import webbrowser

CREDS_FILE = os.path.expanduser("~/.config/quickshell/google_calendar_credentials.json")
TOKENS_FILE = os.path.expanduser("~/.config/quickshell/google_calendar_tokens.json")
CACHE_FILE = os.path.expanduser("~/.cache/quickshell/google_calendar_cache.json")


def load_credentials():
    if not os.path.exists(CREDS_FILE):
        return None
    try:
        with open(CREDS_FILE) as f:
            return json.load(f)
    except Exception:
        return None


def load_tokens():
    if not os.path.exists(TOKENS_FILE):
        return None
    try:
        with open(TOKENS_FILE) as f:
            return json.load(f)
    except Exception:
        return None


def save_tokens(tokens):
    os.makedirs(os.path.dirname(TOKENS_FILE), exist_ok=True)
    with open(TOKENS_FILE, "w") as f:
        json.dump(tokens, f, indent=2)


def load_cache():
    if not os.path.exists(CACHE_FILE):
        return []
    try:
        with open(CACHE_FILE) as f:
            return json.load(f)
    except Exception:
        return []


def save_cache(events):
    os.makedirs(os.path.dirname(CACHE_FILE), exist_ok=True)
    with open(CACHE_FILE, "w") as f:
        json.dump(events, f, indent=2)


def is_network_connected():
    try:
        # Check network via qs-network status
        qs_net = os.path.expanduser("~/.config/quickshell/scripts/qs-network")
        if os.path.exists(qs_net):
            res = subprocess.run([qs_net, "status"], capture_output=True, text=True, timeout=3)
            out = res.stdout.strip().lower()
            if "offline" in out or "unavailable" in out or "disconnected" in out:
                return False
            if "online" in out or "connected" in out or "wifi" in out or "ethernet" in out:
                return True
        # Fallback check
        urllib.request.urlopen("https://www.google.com", timeout=3)
        return True
    except Exception:
        return False


def refresh_access_token(creds, tokens):
    refresh_token = tokens.get("refresh_token")
    if not refresh_token:
        return None

    data = urllib.parse.urlencode({
        "client_id": creds["client_id"],
        "client_secret": creds["client_secret"],
        "refresh_token": refresh_token,
        "grant_type": "refresh_token"
    }).encode("utf-8")

    req = urllib.request.Request(creds["token_uri"], data=data, headers={"Content-Type": "application/x-www-form-urlencoded"})
    try:
        with urllib.request.urlopen(req, timeout=10) as resp:
            res_json = json.loads(resp.read().decode("utf-8"))
            access_token = res_json.get("access_token")
            if access_token:
                tokens["access_token"] = access_token
                save_tokens(tokens)
                return access_token
    except Exception as e:
        sys.stderr.write(f"Token refresh failed: {e}\n")
    return tokens.get("access_token")


def fetch_google_events(req_month=None, req_year=None):
    creds = load_credentials()
    tokens = load_tokens()

    if not creds or not tokens:
        return load_cache()

    if not is_network_connected():
        return load_cache()

    access_token = refresh_access_token(creds, tokens)
    if not access_token:
        return load_cache()

    # Fetch events for 1 full year past to 1 full year future (365 days)
    now = datetime.utcnow()
    if req_month and req_year:
        try:
            target_dt = datetime(int(req_year), int(req_month), 1)
            time_min = (target_dt - timedelta(days=60)).strftime("%Y-%m-%dT00:00:00Z")
            time_max = (target_dt + timedelta(days=120)).strftime("%Y-%m-%dT23:59:59Z")
        except Exception:
            time_min = (now - timedelta(days=365)).strftime("%Y-%m-%dT00:00:00Z")
            time_max = (now + timedelta(days=365)).strftime("%Y-%m-%dT23:59:59Z")
    else:
        time_min = (now - timedelta(days=365)).strftime("%Y-%m-%dT00:00:00Z")
        time_max = (now + timedelta(days=365)).strftime("%Y-%m-%dT23:59:59Z")

    calendars_to_fetch = [
        {"id": "primary", "is_holiday": False},
        {"id": "en.indian#holiday@group.v.calendar.google.com", "is_holiday": True}
    ]

    try:
        cal_list_url = "https://www.googleapis.com/calendar/v3/users/me/calendarList"
        req_list = urllib.request.Request(cal_list_url, headers={"Authorization": f"Bearer {access_token}"})
        with urllib.request.urlopen(req_list, timeout=5) as resp_list:
            cals_data = json.loads(resp_list.read().decode("utf-8"))
            for c_item in cals_data.get("items", []):
                c_id = c_item.get("id", "")
                c_summary = c_item.get("summary", "").lower()
                is_hol = "holiday" in c_id.lower() or "holiday" in c_summary
                if c_id and c_id not in [c["id"] for c in calendars_to_fetch]:
                    calendars_to_fetch.append({"id": c_id, "is_holiday": is_hol})
    except Exception:
        pass

    parsed_events = []
    seen_ids = set()

    for cal in calendars_to_fetch:
        cal_id = cal["id"]
        is_holiday_cal = cal["is_holiday"]
        url = f"https://www.googleapis.com/calendar/v3/calendars/{urllib.parse.quote(cal_id)}/events?timeMin={urllib.parse.quote(time_min)}&timeMax={urllib.parse.quote(time_max)}&singleEvents=true&orderBy=startTime"
        req = urllib.request.Request(url, headers={"Authorization": f"Bearer {access_token}"})

        try:
            with urllib.request.urlopen(req, timeout=10) as resp:
                data = json.loads(resp.read().decode("utf-8"))
                items = data.get("items", [])
                for item in items:
                    event_id = item.get("id", "")
                    if event_id in seen_ids:
                        continue
                    seen_ids.add(event_id)

                    start = item.get("start", {})
                    end = item.get("end", {})
                    start_dt_str = start.get("dateTime") or start.get("date", "")

                    date_part = ""
                    time_part = ""

                    if "T" in start_dt_str:
                        try:
                            iso_str = start_dt_str.replace("Z", "+00:00")
                            local_dt = datetime.fromisoformat(iso_str).astimezone()
                            date_part = local_dt.strftime("%Y-%m-%d")
                            time_part = local_dt.strftime("%I:%M %p")
                        except Exception:
                            date_part = start_dt_str.split("T")[0]
                            time_part = start_dt_str.split("T")[1][:5]
                    else:
                        date_part = start_dt_str
                        time_part = ""

                    parsed_events.append({
                        "id": event_id,
                        "summary": item.get("summary", "Untitled Event"),
                        "description": "",
                        "location": "",
                        "date": date_part,
                        "time": time_part,
                        "is_holiday": is_holiday_cal,
                        "link": item.get("htmlLink", "")
                    })
        except Exception as e:
            sys.stderr.write(f"Fetch events for {cal_id} failed: {e}\n")

    def parse_time_minutes(t_str):
        if not t_str or t_str == "All Day":
            return -1
        try:
            dt = datetime.strptime(t_str, "%I:%M %p")
            return dt.hour * 60 + dt.minute
        except Exception:
            return 9999

    if parsed_events:
        parsed_events.sort(key=lambda x: (x["date"], parse_time_minutes(x["time"]), x["summary"]))
        save_cache(parsed_events)
        return parsed_events
    else:
        return load_cache()


def run_oauth_auth():
    creds = load_credentials()
    if not creds:
        print("Error: credentials file missing!")
        sys.exit(1)

    auth_code = []

    class OAuthHandler(http.server.SimpleHTTPRequestHandler):
        def do_GET(self):
            parsed = urllib.parse.urlparse(self.path)
            query = urllib.parse.parse_qs(parsed.query)
            if "code" in query:
                auth_code.append(query["code"][0])
                self.send_response(200)
                self.send_header("Content-Type", "text/html")
                self.end_headers()
                self.wfile.write(b"<h1>Authorization successful!</h1><p>You can close this tab and return to Quickshell.</p>")
            else:
                self.send_response(400)
                self.end_headers()
                self.wfile.write(b"Authorization failed.")

        def log_message(self, format, *args):
            pass

    redirect_uri = "http://localhost:8080"
    scope = "https://www.googleapis.com/auth/calendar.readonly"
    params = {
        "client_id": creds["client_id"],
        "redirect_uri": redirect_uri,
        "response_type": "code",
        "scope": scope,
        "access_type": "offline",
        "prompt": "consent"
    }
    auth_url = f"{creds['auth_uri']}?{urllib.parse.urlencode(params)}"
    print(f"Opening browser for Google Calendar authorization:\n{auth_url}\n")
    webbrowser.open(auth_url)

    server = socketserver.TCPServer(("localhost", 8080), OAuthHandler)
    server.handle_request()
    server.server_close()

    if not auth_code:
        print("Failed to receive authorization code.")
        sys.exit(1)

    code = auth_code[0]
    token_data = urllib.parse.urlencode({
        "client_id": creds["client_id"],
        "client_secret": creds["client_secret"],
        "code": code,
        "grant_type": "authorization_code",
        "redirect_uri": redirect_uri
    }).encode("utf-8")

    req = urllib.request.Request(creds["token_uri"], data=token_data, headers={"Content-Type": "application/x-www-form-urlencoded"})
    try:
        with urllib.request.urlopen(req, timeout=15) as resp:
            tokens = json.loads(resp.read().decode("utf-8"))
            save_tokens(tokens)
            print("Google Calendar authorization successful! Tokens saved.")
    except Exception as e:
        print(f"Failed to exchange token: {e}")
        sys.exit(1)


action = sys.argv[1] if len(sys.argv) > 1 else "events"

if action == "auth":
    run_oauth_auth()
elif action == "events":
    m_arg = sys.argv[2] if len(sys.argv) > 2 else None
    y_arg = sys.argv[3] if len(sys.argv) > 3 else None
    events = fetch_google_events(m_arg, y_arg)
    print(json.dumps(events))
elif action == "status":
    tokens = load_tokens()
    connected = is_network_connected()
    print(f"authenticated\t{'1' if tokens else '0'}")
    print(f"online\t{'1' if connected else '0'}")
else:
    print(json.dumps([]))
