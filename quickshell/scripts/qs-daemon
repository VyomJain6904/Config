#!/usr/bin/env bash

set -euo pipefail

# Terminate any old qs-daemon instances (skip ourselves)
SCRIPT_PATH="$(realpath "$0")"
for pid in $(pgrep -f "$SCRIPT_PATH" || true); do
    if [ "$pid" != "$$" ] && [ "$pid" != "$PPID" ]; then
        kill -9 "$pid" 2>/dev/null || true
    fi
done

# Terminate orphaned monitor helpers from old Quickshell instances.
pkill -f "playerctl --follow --all-players metadata" 2>/dev/null || true
pkill -f "nmcli monitor" 2>/dev/null || true
pkill -f "i3-msg -t subscribe -m \\[ \"workspace\", \"window\" \\]" 2>/dev/null || true

# Terminate any already running Quickshell instances.
pkill -x quickshell 2>/dev/null || true

# Wait briefly to ensure processes have shut down
sleep 0.5

# Launch Quickshell detached; i3's exec_always reruns this on reload/restart.
quickshell -d -p /home/jain/.config/quickshell
