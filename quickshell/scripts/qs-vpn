#!/usr/bin/env python3

import glob
import json
import os
import subprocess
import sys

VPN_DIR = "/home/jain/vpn"
VPN_CMD = "/home/jain/.local/bin/vpn"
TARGET_FILE = "/tmp/qs_vpn_target.json"
STATE_FILE = "/tmp/qs_vpn_state.json"
IMG_DIR = os.path.join(VPN_DIR, "img")
LOGO_MAP = {
    "hackthebox": "htb.svg",
    "htb": "htb.svg",
    "tryhackme": "tryhackme.svg",
    "thm": "tryhackme.svg",
    "pwnedlabs": "pwnedlabs.svg",
    "pwnedlab": "pwnedlabs.svg",
    "hacksmarter": "HackSmarter.svg",
    "offsec": "offsec.svg",
    "offensivesecurity": "offsec.svg",
}


def read_json(path):
    try:
        with open(path, "r", encoding="utf-8") as handle:
            return json.load(handle)
    except (OSError, json.JSONDecodeError):
        return {}


def vpn_ip():
    try:
        output = subprocess.check_output(
            ["ip", "-4", "addr", "show", "tun0"],
            text=True,
            stderr=subprocess.DEVNULL,
        )
    except (OSError, subprocess.CalledProcessError):
        return ""

    for line in output.splitlines():
        line = line.strip()
        if line.startswith("inet "):
            return line.split()[1].split("/")[0]
    return ""


def profiles():
    rows = []
    for path in sorted(glob.glob(os.path.join(VPN_DIR, "*.ovpn"))):
        name = os.path.splitext(os.path.basename(path))[0]
        rows.append((name, path))
    return rows


def logo_path(name):
    key = "".join(ch.lower() for ch in name if ch.isalnum())
    logo = LOGO_MAP.get(key, "")
    if not logo:
        return ""

    path = os.path.join(IMG_DIR, logo)
    return path if os.path.isfile(path) else ""


def status():
    ip = vpn_ip()
    target = read_json(TARGET_FILE).get("targetIp", "") if ip else ""
    state = read_json(STATE_FILE) if ip else {}
    active_profile = state.get("activeProfile", "") if ip else ""
    connected = "1" if ip else "0"
    print("\t".join([connected, ip, target, active_profile]))


def list_profiles():
    active_profile = read_json(STATE_FILE).get("activeProfile", "")
    for name, path in profiles():
        active = "1" if name == active_profile and vpn_ip() else "0"
        print("\t".join([name, path, active, logo_path(name)]))


def validate_profile(path):
    resolved = os.path.realpath(path)
    vpn_root = os.path.realpath(VPN_DIR)
    if not resolved.startswith(vpn_root + os.sep) or not resolved.endswith(".ovpn"):
        raise ValueError("Invalid VPN profile")
    if not os.path.isfile(resolved):
        raise ValueError("VPN profile does not exist")
    return resolved


def run_vpn(args):
    result = subprocess.run(args, text=True, capture_output=True)
    if result.stdout:
        print(result.stdout, end="")
    if result.stderr:
        print(result.stderr, end="", file=sys.stderr)
    return result.returncode


def connect(argv):
    if len(argv) < 1:
        print("Missing VPN profile", file=sys.stderr)
        return 2

    try:
        profile = validate_profile(argv[0])
    except ValueError as exc:
        print(str(exc), file=sys.stderr)
        return 2

    target_ip = argv[1] if len(argv) > 1 else ""
    return run_vpn([VPN_CMD, "--target-ip", target_ip, "--", profile])


def disconnect():
    return run_vpn([VPN_CMD, "--disconnect"])


def main():
    action = sys.argv[1] if len(sys.argv) > 1 else "status"
    if action == "status":
        status()
        return 0
    if action == "list":
        list_profiles()
        return 0
    if action == "connect":
        return connect(sys.argv[2:])
    if action == "disconnect":
        return disconnect()

    print(f"Unknown action: {action}", file=sys.stderr)
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
